# Supabase project settings → API
# The anon key is public by design: it ships inside the built JavaScript.
# Row Level Security (see supabase/migrations/0001_admin_schema.sql) is what
# actually protects alumni data — never paste the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
